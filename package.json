{
  "name": "logistics-saas-api",
  "version": "0.1.0",
  "private": true,
  "description": "Control plane SaaS logistik: client/tenant, subscription, cluster DB, config DB tenant, dan worker provisioning",
  "main": "src/api.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start:api": "node src/api.js",
    "start:worker": "node src/worker.js",
    "start": "node src/api.js",
    "dev:api": "nodemon src/api.js",
    "dev:worker": "nodemon src/worker.js",
    "lint": "eslint src",
    "migrate": "knex --knexfile src/database/knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile src/database/knexfile.js migrate:rollback",
    "migrate:make": "knex --knexfile src/database/knexfile.js migrate:make",
    "seed": "knex --knexfile src/database/knexfile.js seed:run",
    "seed:make": "knex --knexfile src/database/knexfile.js seed:make"
  },
  "dependencies": {
    "amqplib": "^0.10.9",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.18.1",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.11.1",
    "joi": "^17.6.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^2.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.7.3",
    "swagger-ui-express": "^4.4.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "eslint": "^8.19.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.26.0",
    "nodemon": "^3.1.10"
  }
}
