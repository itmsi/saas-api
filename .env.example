# ===== Umum (saas-api & saas-worker) =====
APP_NAME=logistics-saas-api
# development | production
NODE_ENV=development
TZ=Asia/Jakarta
# id | en
DEFAULT_LANGUAGE=id
# kosong = debug (dev) / info (prod)
LOG_LEVEL=

# DB saas_core. Isi DATABASE_URL, ATAU DB_* terpisah.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=saas_api
DB_PASSWORD=
DB_NAME=saas_core
DB_SSL=false
DB_POOL_MIN=0
DB_POOL_MAX=10

RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379/0
TENANT_CACHE_TTL_SECONDS=600

# AES-256-GCM, 32 byte base64. SAMA dengan logistics-api.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TENANT_DB_ENC_KEY=
TENANT_DB_ENC_KEY_VERSION=1
TENANT_SYSTEM_USERNAME=msi.support
TENANT_DB_POOL_MAX=5
TENANT_DB_APP_CONNECTION_LIMIT=20

# Header X-Internal-Key dari logistics-api
# INTERNAL_API_KEY          -> resolve biasa (role app)
# INTERNAL_PROVISIONING_KEY -> resolve scope=provisioning (role owner) + panggilan worker -> logistics-api
INTERNAL_API_KEY=
INTERNAL_PROVISIONING_KEY=

LOGISTICS_API_INTERNAL_URL=http://localhost:4000/internal

# ===== Proses API =====
PORT=9061
# default: true di development, false di production
SWAGGER_ENABLED=true
# opsional: URL lewat Kong untuk dropdown server di Swagger, mis. https://services.example.com/saas/api/v1
SWAGGER_GATEWAY_URL=
# pisahkan dengan koma
CORS_ORIGINS=*
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_15MIN=20
# URL health server worker dari sisi API (untuk POST /clusters/:id/test-connection)
WORKER_INTERNAL_URL=http://localhost:3100

# Cluster default untuk `npm run seed` (dipakai POST /clients saat cluster_id kosong)
# Kredensial provisioner-nya: <SEED_CLUSTER_SECRET_REF>_USER / _PASSWORD di bagian worker
SEED_CLUSTER_NAME=default
SEED_CLUSTER_HOST=localhost
SEED_CLUSTER_PORT=5432
SEED_CLUSTER_SECRET_REF=CLUSTER_DEFAULT
SEED_CLUSTER_MAX_TENANTS=100

# Admin awal untuk `npm run seed`
SEED_ADMIN_EMAIL=admin@msi.local
SEED_ADMIN_NAME=Super Admin MSI
SEED_ADMIN_PASSWORD=

# ===== Proses worker =====
WORKER_ID=saas-worker-1
WORKER_HEALTH_PORT=3100
OUTBOX_POLL_INTERVAL_MS=1000
LOGISTICS_MIGRATE_TIMEOUT_MS=600000
LOGISTICS_SEED_TIMEOUT_MS=120000
# false = DB dibiarkan saat gagal (untuk debug), retry melanjutkan dari step gagal
ROLLBACK_ON_FAILURE=true
TRANSIENT_RETRY_MAX=3
TRANSIENT_BACKOFF_MS=2000,5000,15000
WORKER_SHUTDOWN_TIMEOUT_MS=600000
WORKER_INTERRUPTED_AFTER_MS=900000
BACKUP_DIR=/backups
# versi pg_dump harus >= versi server Postgres cluster
PG_DUMP_PATH=pg_dump

# Role provisioner per cluster: <db_clusters.admin_secret_ref>_USER / _PASSWORD
# HANYA di env saas-worker, jangan di saas-api / logistics-api.
CLUSTER_DEFAULT_USER=lg_provisioner
CLUSTER_DEFAULT_PASSWORD=
CLUSTER_PG_PROD_01_USER=lg_provisioner
CLUSTER_PG_PROD_01_PASSWORD=
# CLUSTER_PG_PROD_01_DATABASE=postgres
# CLUSTER_PG_PROD_01_SSL=false
